{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build && vite build --ssr",
        "dev": "vite",
        "proxy": "cd services/connection-proxy && python -m uvicorn main:app --host 0.0.0.0 --port 8002",
        "dev:all": "concurrently \"npm run dev\" \"php artisan serve\" \"npm run proxy\""
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^18.13.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@types/react-window": "^1.8.8",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.31",
        "puppeteer": "^24.42.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.0.2",
        "vite": "^6.0.0"
    },
    "dependencies": {
        "axios": "^1.16.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "lucide-react": "^1.8.0",
        "react-window": "^1.8.10",
        "recharts": "^3.8.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwind-scrollbar": "^3.1.0"
    }
